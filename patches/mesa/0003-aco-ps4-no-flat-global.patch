          aco_opcode op = get_buffer_store_op(write_datas[i].bytes());
 
@@ -2681,7 +2685,8 @@
       init_disable_wqm(bld, flat->flatlike(), true);
       ctx->block->instructions.emplace_back(std::move(flat));
    } else {
-      assert(ctx->options->gfx_level == GFX6 || addr.type() != RegType::vgpr);
