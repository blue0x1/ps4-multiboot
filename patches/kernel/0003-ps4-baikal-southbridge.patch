+/*
+ * Baikal: the ICC interrupt arrives through the glue's own MSI, which this
+ * driver does not set up there, so the status register is polled instead:
+ * while a command waits for its reply, and every 50 ms for events (power
+ * button) the rest of the time.
+ */
+#define ICC_POLL_EVENTS_MS 50
+
+static void icc_poll(struct apcie_dev *sc)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&sc->icc_poll_lock, flags);
+	icc_interrupt(0, sc);
+	spin_unlock_irqrestore(&sc->icc_poll_lock, flags);
+}
+
+static void icc_poll_work_fn(struct work_struct *work)
+{
+	struct apcie_dev *sc = container_of(to_delayed_work(work),
+					    struct apcie_dev, icc_poll_work);
+
+	icc_poll(sc);
+	schedule_delayed_work(&sc->icc_poll_work,
+			      msecs_to_jiffies(ICC_POLL_EVENTS_MS));
+}
+
+/* Same result as wait_event_timeout(): 0 on timeout, else > 0. */
+static int icc_poll_for_reply(struct apcie_dev *sc)
+{
+	unsigned long end = jiffies + HZ * icc_timeout;
+
+	while (READ_ONCE(sc->icc.reply_pending)) {
+		icc_poll(sc);
+		if (!READ_ONCE(sc->icc.reply_pending))
+			break;
+		if (time_after(jiffies, end))
+			return 0;
+		if (irqs_disabled() || in_atomic())
+			udelay(200);
+		else
+			usleep_range(100, 300);
+	}
+	return 1;
+}
