diff --git a/drivers/ps4/ps4-apcie.c b/drivers/ps4/ps4-apcie.c
index 285f25ff8..08480e09d 100644
--- a/drivers/ps4/ps4-apcie.c
+++ b/drivers/ps4/ps4-apcie.c
@@ -322,6 +322,87 @@ static int apcie_is_compatible_device(struct pci_dev *dev)
 		dev->device == PCI_DEVICE_ID_SONY_BAIKAL_PCIE);
 }
 
+/*
+ * Baikal interrupts. Each function raises its own standard PCI MSI. The 5.4
+ * Baikal driver's bpcie_handle_edge_irq() acknowledges function 4, 5 and 7
+ * interrupts in the glue before handling them: write 2 (function 4) or 3
+ * (functions 5 and 7) to BPCIE_ACK_WRITE, then read BPCIE_ACK_READ. Here
+ * that runs as the first handler on the vector, ahead of the device's own.
+ */
+struct bpcie_ack {
+	struct apcie_dev *sc;
+	u32 value;
+};
+
+static struct bpcie_ack bpcie_acks[AEOLIA_NUM_FUNCS];
+static DEFINE_RAW_SPINLOCK(bpcie_ack_lock);
+static bool apcie_baikal;
+
+static bool bpcie_func_needs_ack(unsigned int func)
+{
+	return func == AEOLIA_FUNC_ID_PCIE || func == AEOLIA_FUNC_ID_DMAC ||
+	       func == AEOLIA_FUNC_ID_XHCI;
+}
+
+static irqreturn_t bpcie_ack_irq(int irq, void *arg)
+{
+	struct bpcie_ack *ack = arg;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&bpcie_ack_lock, flags);
+	iowrite32(ack->value, ack->sc->bar2 + BPCIE_ACK_WRITE);
+	ioread32(ack->sc->bar2 + BPCIE_ACK_READ);
+	raw_spin_unlock_irqrestore(&bpcie_ack_lock, flags);
+
+	/* Not ours: the device's handler on this vector does the work. */
+	return IRQ_NONE;
+}
+
+static int bpcie_assign_irqs(struct apcie_dev *sc, struct pci_dev *dev, int nvec)
+{
+	unsigned int func = PCI_FUNC(dev->devfn);
+	int n, i, ret;
+
+	n = pci_alloc_irq_vectors(dev, 1, nvec, PCI_IRQ_MSI);
+	if (n < 0) {
+		dev_err(&dev->dev, "baikal: no MSI vectors: %d\n", n);
+		return n;
+	}
+	dev_info(&dev->dev, "baikal: %d of %d MSI vectors from irq %d\n",
+		 n, nvec, dev->irq);
+
+	if (bpcie_func_needs_ack(func)) {
+		bpcie_acks[func].sc = sc;
+		bpcie_acks[func].value = func == AEOLIA_FUNC_ID_PCIE ? 2 : 3;
+		for (i = 0; i < n; i++) {
+			ret = request_irq(pci_irq_vector(dev, i), bpcie_ack_irq,
+					  IRQF_SHARED, "baikal-ack",
+					  &bpcie_acks[func]);
+			if (ret)
+				dev_warn(&dev->dev, "baikal: ack handler on vector %d: %d\n",
+					 i, ret);
+		}
+	}
+	return n;
+}
+
+static bool bpcie_free_irqs(unsigned int virq, unsigned int nr_irqs)
+{
+	struct msi_desc *desc = irq_get_msi_desc(virq);
+	struct pci_dev *dev;
+	unsigned int func, i;
+
+	if (!desc)
+		return false;
+	dev = msi_desc_to_pci_dev(desc);
+	func = PCI_FUNC(dev->devfn);
+	if (bpcie_func_needs_ack(func))
+		for (i = 0; i < nr_irqs; i++)
+			free_irq(pci_irq_vector(dev, i), &bpcie_acks[func]);
+	pci_free_irq_vectors(dev);
+	return true;
+}
+
 int apcie_assign_irqs(struct pci_dev *dev, int nvec)
 {
 	int ret;
@@ -345,6 +426,11 @@ int apcie_assign_irqs(struct pci_dev *dev, int nvec)
 		goto fail;
 	}
 
+	if (sc->baikal) {
+		ret = bpcie_assign_irqs(sc, dev, nvec);
+		goto fail;
