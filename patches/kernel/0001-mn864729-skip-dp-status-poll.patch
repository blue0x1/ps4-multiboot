diff --git a/drivers/gpu/drm/amd/amdgpu/atombios_dp.c b/drivers/gpu/drm/amd/amdgpu/atombios_dp.c
index 518707bc9..2f74987f8 100644
--- a/drivers/gpu/drm/amd/amdgpu/atombios_dp.c
+++ b/drivers/gpu/drm/amd/amdgpu/atombios_dp.c
@@ -500,6 +500,9 @@ void amdgpu_atombios_dp_set_rx_power_state(struct drm_connector *connector,
 	}
 }
 
+/* Fat CUH-10xx/11xx Liverpool; its MN86471A bridge answers DP link status. */
+#define PCI_DEVICE_ID_CUH_11XX 0x9920
+
 struct amdgpu_atombios_dp_link_train_info {
 	struct amdgpu_device *adev;
 	struct drm_encoder *encoder;
@@ -507,6 +510,7 @@ struct amdgpu_atombios_dp_link_train_info {
 	int dp_clock;
 	int dp_lane_count;
 	bool tp3_supported;
+	bool skip_status_check;
 	u8 dpcd[DP_RECEIVER_CAP_SIZE];
 	u8 train_set[4];
 	u8 link_status[DP_LINK_STATUS_SIZE];
@@ -623,6 +627,14 @@ amdgpu_atombios_dp_link_train_cr(struct amdgpu_atombios_dp_link_train_info *dp_i
 
 	udelay(400);
 
+	/* The MN864729 bridge (Slim/Pro) trains the internal DP link itself and
+	 * never reports clock recovery; polling it only fails. Approach from the
+	 * Android TV for PS4 16 kernel (GPL). */
+	if (dp_info->skip_status_check) {
+		DRM_DEBUG_KMS("dp cr: skipping status poll (mn864729 fixed link)\n");
+		return 0;
+	}
+
 	/* clock recovery loop */
 	clock_recovery = false;
 	dp_info->tries = 0;
@@ -689,6 +701,11 @@ amdgpu_atombios_dp_link_train_ce(struct amdgpu_atombios_dp_link_train_info *dp_i
 	else
 		amdgpu_atombios_dp_set_tp(dp_info, DP_TRAINING_PATTERN_2);
 
+	if (dp_info->skip_status_check) {
+		DRM_DEBUG_KMS("dp ce: skipping status poll (mn864729 fixed link)\n");
+		return 0;
+	}
+
 	/* channel equalization loop */
 	dp_info->tries = 0;
 	channel_eq = false;
@@ -772,6 +789,9 @@ void amdgpu_atombios_dp_link_train(struct drm_encoder *encoder,
 	dp_info.dp_lane_count = dig_connector->dp_lane_count;
 	dp_info.dp_clock = dig_connector->dp_clock;
 	dp_info.aux = &amdgpu_connector->ddc_bus->aux;
+	dp_info.skip_status_check = (adev->asic_type == CHIP_LIVERPOOL ||
+				     adev->asic_type == CHIP_GLADIUS) &&
+				    adev->pdev->device != PCI_DEVICE_ID_CUH_11XX;
 
 	if (amdgpu_atombios_dp_link_train_init(&dp_info))
 		goto done;
