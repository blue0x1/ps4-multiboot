# PS4 kernel config fragment.
# Merged on top of the PS4 kernel tree's own `config` (which holds all the
# PS4 hardware support). Only options this project needs beyond that live here.

CONFIG_LOCALVERSION="-kali-ps4"

# --- Boot path used by our initramfs: these MUST be built in (=y) ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y

# --- systemd requirements ---
CONFIG_CGROUPS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y

# --- Networking used by security tools ---
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_MACVLAN=m
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NF_CONNTRACK=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_WIREGUARD=m

# --- USB Wi-Fi adapters common in pentesting (monitor mode / injection) ---
# The PS4's internal Wi-Fi cannot do monitor mode; use one of these.
CONFIG_ATH9K_HTC=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8187=m
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7921U=m

# --- USB Ethernet adapters ---
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m

# --- Bluetooth dongles, controllers, SDR ---
CONFIG_BT_HCIBTUSB=m
CONFIG_HID_SONY=m
CONFIG_HID_PLAYSTATION=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_ACM=m

# Upstream config points at the original developer's home dir; the blobs ship in-tree.
CONFIG_EXTRA_FIRMWARE_DIR="extra_firmware"

# pahole gets killed generating BTF on this host (memory); not needed to boot.
# CONFIG_DEBUG_INFO_BTF is not set

# GPU driver built in: as a module it loads ~60s into boot and its GFX/SDMA
# engines then report illegal instructions; rebinding it also fails.
CONFIG_DRM_AMDGPU=y

# PS4 controller (DualShock 4) driver built in, so the first-boot installer
# can use it (the initramfs loads no modules).
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
