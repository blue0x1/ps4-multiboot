# Parrot OS (Security edition base): base image, menu name, logo and default login.
# NAME: shown in the menu (default: NAME from os-release).
# LOGO: logo file inside the image (default: the icon named in os-release).
NAME="Parrot OS"
BASE_IMAGE=docker.io/parrotsec/core:latest
USER_NAME=parrot
USER_PASS=parrot
LOGO=/usr/share/icons/parrot-logo.png
